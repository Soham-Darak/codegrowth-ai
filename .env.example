# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=codegrowth
POSTGRES_USER=codegrowth_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Application
APP_ENV=development
BACKEND_PORT=8080
AI_ENGINE_BASE_URL=http://localhost:8000
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# GitHub OAuth (for login — separate from GITHUB_TOKEN for repo analysis)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# GitHub API (for repository analysis)
GITHUB_TOKEN=your_github_personal_access_token

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
